type action_hash = Hash[Symbol, (source_hash | String | type_hash)]

module Wrapture
  class ActionSpec
    include Sourced

    @source: Hash[Symbol, Hash[Symbol, Array[String]]]
    @type_spec: TypeSpec
    @value: String | nil

    attr_reader source: Hash[Symbol, Hash[Symbol, CSource::CFunction]]
    attr_reader type_spec: TypeSpec
    attr_accessor value: String

    def self.from_hash: (action_hash) -> ActionSpec

    def initialize: (String | Array[String], TypeSpec) -> void
    def value?: () -> bool
  end
end
