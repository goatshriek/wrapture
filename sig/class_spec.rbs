module Wrapture
  class ClassSpec
    include Named

    @doc: Wrapture::Comment
    @parent: Enumerable[String] | nil
    @source: Hash[Symbol, CSource::CStruct] | nil
    @spec: spec_hash

    attr_reader doc: Wrapture::Comment
    attr_reader parent: Enumerable[String] | nil
    attr_reader source: Hash[Symbol, CSource::CStruct] | nil

    def self.effective_type: (spec_hash spec) -> String
    def self.from_hash: (spec_hash spec) -> Wrapture::ClassSpec
    def self.normalize_spec_hash: (spec_hash spec) -> spec_hash
    def self.normalize_spec_hash!: (spec_hash spec) -> spec_hash

    def initialize: (spec_hash spec) -> void
    def []: (Symbol) -> CSource::CStruct
    def []=: (Symbol, CSource::CStruct) -> CSource::CStruct
    def child?: -> bool
    def equivalent_member?: -> bool
    def exception?: -> bool
    def name_words: -> Array[String]
  end
end
