module Wrapture
  module PythonSource
    class PythonSourceSet
      include SourceSet

      @module_links: Array[String]
      @module_sources: Array[Wrapture::SourceFile]
      @name: String

      attr_reader module_links: Array[String]
      attr_reader module_sources: Array[Wrapture::SourceFile]
      attr_reader name: String

      def initialize: (String) -> void
      def add_module_source: (Wrapture::SourceFile) -> void
      def add_link: (String) -> void
      def sources: -> Array[Wrapture::SourceFile]
    end
  end
end