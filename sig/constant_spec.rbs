type constant_hash = Hash[Symbol, (Enumerable[String] | name_type | String)]

module Wrapture
  class ConstantSpec
    include Named
    include Sourced

    @doc: Comment
    @name_words: Array[String]
    @source: Hash[Symbol, untyped]
    @type_spec: TypeSpec
    @value: String

    attr_accessor doc: Comment
    attr_reader name_words: Array[String]
    attr_reader source: Hash[Symbol, untyped]
    attr_reader type_spec: TypeSpec
    attr_reader value: String

    def self.from_hash: (constant_hash) -> ConstantSpec
    def self.validate_hash: (constant_hash) -> void

    def initialize: (name_type, (name_type | TypeSpec), String) -> void
  end
end
