module Wrapture
  module Build
    class CmakeBuild
      include Build

      @build_info: (Wrapture::Build::CppBuild | Wrapture::Build::CBuild)

      attr_reader build_info: (Wrapture::Build::CppBuild | Wrapture::Build::CBuild)

      def self.from_hash: (spec_hash) -> Wrapture::Build::CmakeBuild

      def initialize: (Wrapture::Build::CppBuild | Wrapture::Build::CBuild) -> void
      def build_system_sources: -> Enumerable[Wrapture::SourceFile]
      def cmake_lists: -> Wrapture::SourceFile
      def sources: -> Enumerable[Wrapture::SourceFile]
    end
  end
end