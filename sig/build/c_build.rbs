module Wrapture
  module Build
    class CBuild
      include Build

      @lib_headers: Array[Wrapture::SourceFile]
      @lib_links: Array[String]
      @lib_sources: Array[Wrapture::SourceFile]
      @name: String

      attr_reader lib_headers: Array[Wrapture::SourceFile]
      attr_reader lib_links: Array[String]
      attr_reader lib_sources: Array[Wrapture::SourceFile]
      attr_reader name: String

      def self.from_hash: (spec_hash) -> Wrapture::Build::CBuild

      def initialize: (String) -> void
      def <<: (Wrapture::Build::CBuild) -> (Wrapture::Build::CBuild)
      def add_lib_header: (Wrapture::SourceFile) -> void
      def add_lib_source: (Wrapture::SourceFile) -> void
      def add_lib_link: (String) -> void
      def sources: -> Array[Wrapture::SourceFile]
    end
  end
end