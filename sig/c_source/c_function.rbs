module Wrapture
  module CSource
    class CFunction
      include CBlock

      @name: String
      @tree: Array[untyped]

      attr_reader name: String
      attr_reader params: Array[CDeclaration]
      attr_reader return_type: CType

      def initialize: (String, ?params: Array[CDeclaration], ?return_type: CType) -> void
      def add_param: (CDeclaration) -> CFunction
    end
  end
end
