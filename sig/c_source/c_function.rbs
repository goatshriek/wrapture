module Wrapture
  module CSource
    class CFunction
      include CBlock

      @attributes: Array[String]
      @name: String
      @params: Enumerable[CDeclaration]
      @return_type: CType
      @tree: Array[untyped]

      attr_reader attributes: Enumerable[String]
      attr_reader name: String
      attr_reader params: Enumerable[CDeclaration]
      attr_reader return_type: CType
      attr_reader tree: Array[untyped]

      def initialize: (String, ?params: Enumerable[CDeclaration], ?return_type: CType) -> void
      def add_fail_label: (String, ?String) -> CFunction
      def add_param: (CDeclaration) -> CFunction
      def declaration: () -> CDeclaration
    end
  end
end
