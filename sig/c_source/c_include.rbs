module Wrapture
  module CSource
    class CInclude
      @comment: Comment
      @file: String
      @quote: bool

      attr_reader file: String
      attr_reader comment: Comment
      attr_reader quote: bool

      def initialize: (String, ?comment: Comment | String, ?quote: bool) -> void
    end
  end
end
