module Wrapture
  module Wrapper
    module CToCpp
      extend Wrapper

      def self.ancestor_suffix: (ClassSpec) -> String
      def self.class_name: (ClassSpec) -> String
      def self.converter: (untyped, untyped, Context) -> Proc
      def self.declaration_filename: (untyped) -> String
      def self.declaration_includes: (Context) -> Array[String]
      def self.declare_class: (Context) -> SourceFile
      def self.declare_member_function_locals: (CppSource::CppBlock, Context) -> CppSource::CppBlock
      def self.define_alias_constructor: (ClassSpec, FunctionSpec) -> CppSource::CppFunction
      def self.define_class: (Context) -> SourceFile
      def self.define_constructor: (Context) -> CppSource::CppFunction
      def self.define_enum: (ClassSpec, Scope) -> SourceFile
      def self.defined_class: (Context) -> CppSource::CppClass
      def self.definition_filename: (ClassSpec | EnumSpec) -> String
      def self.definition_includes: (Context) -> Array[String]
      def self.enum_from_spec: (EnumSpec) -> CppSource::CppEnum
      def self.factory_member_function: (Context) -> CppSource::CppFunction
      def self.forward_declared?: (untyped) -> String
      def self.generate_pointer_copy_constructor?: (Context) -> bool
      def self.generate_pointer_move_constructor?: (Context) -> bool
      def self.header_name: (Scope | ClassSpec | EnumSpec) -> String
      def self.member_constructor: (ClassSpec) -> CppSource::CppFunction
      def self.member_function_from_spec: (FunctionSpec) -> CppSource::CppFunction
      def self.namespace_context_header: (Context) -> CppSource::CppSourceFile
      def self.pointer_copy_constructor: (Context) -> CppSource::CppFunction
      def self.pointer_move_constructor: (Context) -> CppSource::CppFunction
      def self.resolve_action_value: (FunctionSpec, String) -> String
      def self.resolve_wrapped_param: (FunctionSpec, CSource::CDeclaration) -> String
      def self.type_class: (Context) -> CppSource::CppClass
      def self.wrap_class_context: (Context) -> CppSource::CppSourceSet
      def self.wrap_constant_context: (Context) -> CppSource::CppSourceSet
      def self.wrap_enum_context: (Context) -> CppSource::CppSourceSet
      def self.wrap_function_context: (Context) -> CppSource::CppSourceSet
      def self.wrap_namespace_context: (Context) -> CppSource::CppSourceSet
      def self.wrapped_error_check: (FunctionSpec) -> Array[untyped]
      def self.wrapped_function_call: (FunctionSpec) -> String
      def self.wrapper_captures_return?: (FunctionSpec) -> bool
    end
  end
end