module Wrapture
  module Wrapper
    module C
      def self.decorate_name_words: (Array[String]) -> Array[String]
      def self.equivalent_ancestor?: (Context) -> bool
      def self.equivalent_member?: (Context) -> bool
      def self.equivalent_pointer: (ClassSpec) -> CSource::CPointer?
      def self.equivalent_struct: (ClassSpec) -> CSource::CStruct?
      def self.equivalent_type: (ClassSpec) -> CSource::CType?
      def self.factory?: (Context) -> bool
      def self.includes: (Scope | ClassSpec | FunctionSpec | ParamSpec | ConstantSpec | TypeSpec) -> Array[String]
      def self.overload?: (ClassSpec, ClassSpec) -> bool
      def self.wrapped_members?: (ClassSpec) -> bool
    end
  end
end