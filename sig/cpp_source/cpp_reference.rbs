module Wrapture
  module CppSource
    class CppReference
      @cpp_type: CppType | CppClass

      attr_reader cpp_type: CppType | CppClass

      def initialize: (CppType | CppClass | String) -> void
      def ==: (CppReference) -> bool
      alias eql? ==
      def includes: () -> Enumerable[String]
      def to_s: () -> String
    end
  end
end