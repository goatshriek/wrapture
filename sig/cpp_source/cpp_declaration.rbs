module Wrapture
  module CppSource
    class CppDeclaration
      @cpp_type: untyped
      @name: String | nil
      @attributes: Array[String]
      @value: Array[untyped] | String | nil

      attr_reader cpp_type: untyped
      attr_reader name: String
      attr_reader attributes: Enumerable[String]
      attr_reader value: Array[untyped] | String | nil

      def initialize: (untyped, String, ?Array[String], ?String) -> void
      def ==: (CppDeclaration) -> bool
      alias eql? ==
      def initialized?: () -> bool
    end
  end
end
