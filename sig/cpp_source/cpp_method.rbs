module Wrapture
  module CppSource
    class CppMethod
      @accessibility: Symbol
      @name: String
      @return_type: CppType
      @tree: Array[untyped]

      attr_accessor accessibility: Symbol
      attr_accessor attributes: Array[String]
      attr_reader name: String
      attr_reader params: Array[untyped]
      attr_accessor return_type: CppType
      attr_reader tree: Array[untyped]

      def initialize: (String) -> void
    end
  end
end
