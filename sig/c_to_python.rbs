module Wrapture
  module CToPython
    def self.add_class_object: (Wrapture::SourceFile, Wrapture::ClassSpec) -> Wrapture::SourceFile
    def self.add_enum_object: (Wrapture::SourceFile, Wrapture::EnumSpec) -> Wrapture::SourceFile
    def self.add_module_objects: (Wrapture::SourceFile, Wrapture::Scope) -> Wrapture::SourceFile
    def self.declare_module_struct: (Wrapture::SourceFile, Wrapture::Scope) -> Wrapture::SourceFile
    def self.class_struct_pointer: (Wrapture::ClassSpec, ?var_name: String) -> String
    def self.class_members_declaration: (Wrapture::ClassSpec) -> Wrapture::CSource::CDeclaration
    def self.class_type_object_declaration: (Wrapture::ClassSpec) -> Wrapture::CSource::CDeclaration
    def self.class_type_struct: (Wrapture::ClassSpec) -> Wrapture::CSource::CStruct
    def self.define_module: (Wrapture::Scope) -> Wrapture::SourceFile
    def self.define_module_init: (Wrapture::SourceFile, Wrapture::Scope) -> Wrapture::SourceFile
    def self.equivalent_member_declaration: (Wrapture::ClassSpec) -> Wrapture::CSource::CDeclaration
    def self.factory_constructor: (Wrapture::ClassSpec) -> Wrapture::CSource::CFunction
    def self.finalize_module_types: (Wrapture::CSource::CBlock, Wrapture::Scope) -> Wrapture::SourceFile
    def self.runtime_class?: (Wrapture::ClassSpec) -> bool
    def self.type_object_name: (Wrapture::Named class_spec) -> String
    def self.type_object_pointer: (Wrapture::ClassSpec class_spec) -> (String | nil)
    def self.type_struct_name: (Wrapture::Named class_spec) -> String
    def self.wrap_scope: (Wrapture::Scope) -> Wrapture::PythonBuild
  end
end