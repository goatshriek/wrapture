module Wrapture
  class TypeSpec
    include Named

    @name_words: Array[String]

    ANY_TYPE_NAME: Array[String]
    VOID_TYPE_NAME: Array[String]

    attr_reader name_words: Array[String]

    def self.from_hash: (spec_hash) -> TypeSpec

    def initialize: (String | Array[String]) -> void
    def ==: (untyped other) -> untyped
    def any: () -> bool
    def base: -> String
    def equivalent_pointer?: -> bool
    def equivalent_struct?: -> bool
    def function: -> (Wrapture::FunctionSpec | nil)
    def function?: -> bool
    def includes: -> untyped
    def pointer?: -> bool
    def self?: () -> bool
    def to_s: -> String
    def void?: () -> bool
  end
end
