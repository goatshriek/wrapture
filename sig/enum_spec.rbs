type enum_element_hash = Hash[Symbol, (name_type | String)]
type enum_hash = Hash[Symbol, (Array[enum_element_hash] | name_type | source_hash)]

module Wrapture
  class EnumSpec
    include Named
    include Sourced

    @doc: Comment
    @elements: Array[enum_element_hash]
    @name_words: Array[String]
    @source: source_hash

    attr_accessor doc: Comment
    attr_reader elements: Array[enum_element_hash]
    attr_reader name_words: Array[String]
    attr_reader source: source_hash

    def self.element_from_hash: (enum_element_hash) -> spec_hash
    def self.from_hash: (enum_hash) -> EnumSpec
    def self.validate_hash: (enum_hash) -> void

    def initialize: (name_type) -> void
    def []: (Symbol) -> untyped
    def []=: (Symbol, untyped) -> untyped
  end
end
