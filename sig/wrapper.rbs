module Wrapture
  module Wrapper
    def from_language: () -> Symbol
    def to_language: () -> Symbol
    def wrap: ((ClassSpec | ConstantSpec | EnumSpec | FunctionSpec | Namespace | Context)) -> SourceSet
    def wrap_class: (ClassSpec) -> SourceSet
    def wrap_constant: (ConstantSpec) -> SourceSet
    def wrap_enum: (EnumSpec) -> SourceSet
    def wrap_function: (FunctionSpec) -> SourceSet
    def wrap_namespace: (Namespace) -> SourceSet
  end

  WRAPPERS: Array[Wrapture::Wrapper]
  def self.paths: (?from: (Symbol | Array[Symbol]), ?to: (Symbol | Array[Symbol]), ?modules: Array[Wrapper]) -> Array[Wrapper]
end
