module Wrapture
  class Context
    include Named

    @contents: Set[Context]
    @parent: Context | nil
    @root: Named

    attr_reader contents: Set[Context]
    attr_reader parent: Context | nil
    attr_reader root: Named

    def self.from_namespace_hash: (spec_hash) -> Context
    def self.from_namespace_yaml_file: (String) -> Context

    def initialize: (from: Named, ?parent: Context) -> void
    def <<: (Context | Named) -> Context
    def classes: -> Enumerable[Context]
    def constants: -> Enumerable[Context]
    def enums: -> Enumerable[Context]
    def functions: -> Enumerable[Context]
    def name_words: () -> Enumerable[String]
    def namespace: -> Enumerable[Context]
    def parent?: () -> bool
    def resolve: () {(Context) -> bool} -> (Context | nil)
    def resolve_name: (Enumerable[String]) -> (Context | nil)
    def top: () -> Context
  end
end